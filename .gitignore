# ============================================================
#  IT 資產管理系統｜Web 版｜Git 忽略清單
#  只把「程式碼 / 文件」納入版控；資料庫、附件、備份、相依套件不進版控
# ============================================================

# ---------- Node 相依套件 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.pnpm-store/

# ---------- 資料（含實際資產資料與個資，禁止上傳） ----------
data/
uploads/
backups/
updates/
config.json
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- 執行期暫存 / 報表 ----------
*.log
IT_資產盤點報表_*.xlsx
IT_Asset_Inventory_*.csv
~$*.xlsx
*.tmp
*.bak

# ---------- 打包產物 ----------
dist/
out/
release/

# ---------- 編輯器 / 作業系統 ----------
.vscode/
.idea/
*.code-workspace
Thumbs.db
desktop.ini
.DS_Store

# ---------- 環境變數 / 金鑰 ----------
.env
.env.*
*.pem
*.pfx
*.key
